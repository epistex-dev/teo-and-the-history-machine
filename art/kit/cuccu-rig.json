{
  "shade": {
    "offset": [2, 3],
    "files": [
      "<part>-shade.svg",
      "<part>-lit.svg"
    ],
    "rule": "Draw <part>-shade at the lit sprite position + (2,3) in world space, below the lit sprite and above everything drawn earlier. Rotate and scale the shade sprite with the part, but never rotate the (2,3) offset. Inside a rotated container, add the offset in world space too (or counter-rotate it by the container angle). Parts without a -shade file cast none. File coordinates: each sprite file has viewBox = bbox, so its top-left sits at bbox[0],bbox[1] of the character frame; pivots are in frame coordinates."
  },
  "rest": {
    "pose": "normal",
    "rule": "Parts and containers with a rest entry are posed as in <character>/expr-normal.svg: rotate by angle (SVG degrees, clockwise positive) about pivot, then translate by offset (parent frame), inside the rotated containers. No rest entry = angle 0. visible:false = only shown in other poses (fx, stamp). The face sprite kit/<character>-face-normal.svg goes inside the head rig. node art/safe-bg.mjs rebuilds every character this way and compares it with expr-normal.svg."
  },
  "plate": {
    "files": "kit/plate-<colour>.svg",
    "topLeft": [-28, -8],
    "colourByBackground": "style.json plate",
    "safeBackgrounds": "style.json castSafeBg"
  },
